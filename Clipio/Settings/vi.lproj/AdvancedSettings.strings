"Title" = "Nâng cao";
"TurnOff" = "Tắt";
"TurnOffDescription" = "Tạm thời bỏ qua tất cả các bản sao mới.\nBạn có thể sẽ sử dụng tính năng này thông qua lập trình và tắt ứng dụng khi sao chép dữ liệu nhạy cảm.";
"TurnOffShellScript" = "defaults write com.clipio.app ignoreEvents true\n# copy data\ndefaults write com.clipio.app ignoreEvents false";
"TurnOffViaMenuIconDescription" = "Bạn cũng có thể nhấp vào biểu tượng menu khi giữ phím ⌥ .\nĐể chỉ bỏ qua lần sao chép tiếp theo, hãy nhấp khi giữ đồng thời ⌥ ⇧ .";
"TurnOffNextShellScript" = "defaults write com.clipio.app ignoreOnlyNextEvent true\n# copy data";
"ClearHistoryOnQuit" = "Xóa lịch sử khi thoát";
"ClearHistoryOnQuitTooltip" = "Remove ordinary clipboard history on quit. Favorites are kept.";
"ClearSystemClipboard" = "Xóa cả bảng nhớ tạm của hệ thống nữa";
"ClearSystemClipboardTooltip" = "Khi được kích hoạt, việc xóa lịch sử cũng sẽ xóa bảng nhớ tạm hiện tại của hệ thống.";
